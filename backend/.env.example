PROJECT_NAME=Academy Platform
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/academy_platform
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-in-production-use-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Tier 12+ — AI provider keys for question bank ingest / generation.
# Gemini handles PDF/image multimodal parsing. DeepSeek handles bulk
# text generation. Leave blank to disable that provider.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Where extracted question diagrams are written. Keep relative to repo
# root for dev; mount a volume in prod.
UPLOADS_DIR=uploads
