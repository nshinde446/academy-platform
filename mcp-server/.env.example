# Copy to .env and fill in. Then either source it before `python server.py`,
# or wire the same env vars into your MCP client config (e.g. Claude Desktop).

# Where the FastAPI backend is reachable from the MCP server's host.
ACADEMY_API_URL=http://localhost:8000

# JWT issued at POST /api/v1/auth/login.
# Grab the `access_token` cookie value from the login response.
ACADEMY_API_TOKEN=replace_with_jwt

# UUID of the branch the MCP server operates on (analytics/attendance
# endpoints scope results by branch). One MCP server install = one branch.
ACADEMY_BRANCH_ID=replace_with_branch_uuid
