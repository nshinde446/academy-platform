[Unit]
Description=Redirect BioMax terminal port-80 traffic to aidata-proxy
Documentation=https://github.com/nshinde446/academy-platform/blob/master/docs/biomax-attendance.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/default/aidata-redirect
# Idempotent: -C tests for the rule first, so restarts never stack duplicates.
ExecStart=/bin/sh -c "iptables -t nat -C PREROUTING -s ${DEVICE_IP} -p tcp --dport 80 -j REDIRECT --to-ports ${PROXY_PORT} 2>/dev/null || iptables -t nat -A PREROUTING -s ${DEVICE_IP} -p tcp --dport 80 -j REDIRECT --to-ports ${PROXY_PORT}"
ExecStop=/bin/sh -c "iptables -t nat -D PREROUTING -s ${DEVICE_IP} -p tcp --dport 80 -j REDIRECT --to-ports ${PROXY_PORT} 2>/dev/null || true"

[Install]
WantedBy=multi-user.target
