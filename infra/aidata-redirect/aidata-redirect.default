# Installed to /etc/default/aidata-redirect
#
# Public IP the BioMax terminal pushes from (the institute's NAT address).
#
# !! If the ISP changes this address, attendance stops SILENTLY — the device
# keeps pushing to port 80, Caddy answers with a header case it rejects, and
# nothing errors anywhere. Find the current address with:
#
#   tcpdump -i eth0 -nn "tcp[tcpflags] & tcp-syn != 0 and dst port 80"
#
# then update DEVICE_IP below and run:
#
#   systemctl restart aidata-redirect
#
# THIS WHOLE UNIT IS A STOPGAP. The permanent fix is to set the device's push
# port to 8099 so it reaches aidata-proxy directly; then disable and delete it.
DEVICE_IP=58.84.61.194
PROXY_PORT=8099
