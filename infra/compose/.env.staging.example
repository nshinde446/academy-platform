# Copy to .env.staging on the VPS and fill in. NEVER commit .env.staging.
# Use DIFFERENT secrets and a DIFFERENT database from production.

# --- runtime ---
ENVIRONMENT=staging
LOG_LEVEL=DEBUG

# --- auth / JWT (MUST be different from prod) ---
SECRET_KEY=replace_me_with_a_different_long_random_string

# --- database ---
POSTGRES_USER=academy_staging_user
POSTGRES_PASSWORD=replace_me_with_a_strong_password
POSTGRES_DB=academy_staging
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- CORS (your Vercel preview/staging deployments) ---
CORS_ORIGINS=https://academy-staging.vercel.app,https://*.vercel.app

# --- image tag — set by CI ---
BACKEND_IMAGE=ghcr.io/nshinde446/academy-platform-backend:staging
