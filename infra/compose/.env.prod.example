# Copy to .env.prod on the VPS and fill in real values. NEVER commit .env.prod.
#
# Generate a strong SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- auth / JWT ---
SECRET_KEY=replace_me_with_a_long_random_string

# --- database (matches the compose `db` service name) ---
POSTGRES_USER=academy_prod_user
POSTGRES_PASSWORD=replace_me_with_a_strong_password
POSTGRES_DB=academy_prod
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- redis (matches the compose `redis` service name) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- CORS (frontend origins that may call the API directly) ---
# JSON array — Pydantic settings expects this format.
# Add Vercel preview URLs / custom domains as you set them up.
CORS_ORIGINS=["https://app.eduworld-livekit.duckdns.org"]

# --- AI extraction (Materials ingest → questions) ---
# Gemini Vision reads uploaded PDFs and extracts MCQs when an admin
# clicks "Ingest" on a material. Without this, ingest fails with
# "GEMINI_API_KEY not set". Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# --- biometric attendance (BioMax / similar) ---
# When the vendor pushes punch events to /api/v1/attendance/biomax/webhook,
# they must send this exact value in the `X-Biomax-Secret` header. Pick a
# long random string; rotate if it ever leaks.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to refuse all webhook requests until you wire up the vendor.
BIOMAX_WEBHOOK_SECRET=
# Cloud ID from your BioMax dashboard. Used for outbound polling once
# vendor docs land; webhook receiver currently ignores it.
BIOMAX_CLOUD_ID=

# --- BioMax direct device push (ADMS/iclock — no PC) ---
# Point the device's Comm > Cloud Server Setting (or Settings > Network >
# Server IP/Port + Realtime Req) at https://<app-domain>; it pushes punches to
# /iclock/cdata. See docs/biomax-direct-push-setup.md.
# Allowlist of device serials (a.k.a. Cloud Number) allowed to push, comma-
# separated. Empty = reject every device (fail-safe / 401).
BIOMAX_DEVICE_SERIALS=
# Branch UUID every pushed punch is attributed to (from GET /api/v1/auth/me,
# branch_roles[].branch_id). Empty = the /iclock endpoint returns 503.
BIOMAX_BRANCH_ID=

# --- BioMax SmartOffice (on-prem agent push) ---
# The institute's SmartOffice app stores punches in SQL; a small on-prem agent
# (agent/smartoffice/) reads new rows and POSTs them to
# /api/v1/attendance/smartoffice/ingest. These two vars are all the agent-push
# path needs (it runs synchronously — no Celery, no SMARTOFFICE_ENABLED/API key).
#
# Shared secret the agent presents in the `X-SmartOffice-Token` header. Must
# equal `token` in the agent's agent.ini. Empty = reject all agent pushes
# (fail-safe). Generate a long random value:
#   openssl rand -hex 32
SMARTOFFICE_INGEST_TOKEN=
# Branch UUID every SmartOffice punch is attributed to. Get it from
# GET /api/v1/auth/me (branch_roles[].branch_id) while logged in.
SMARTOFFICE_BRANCH_ID=
#
# Optional — only for the alternative SmartOffice cloud REST *pull* (not the
# agent). Leave blank when using the agent. See backend settings for the rest
# (SMARTOFFICE_BASE_URL, SMARTOFFICE_API_KEY, SMARTOFFICE_LOOKBACK_DAYS,
# SMARTOFFICE_DEVICE_SERIALS).
SMARTOFFICE_ENABLED=false

# --- image tags — set by CI; defaults for manual `up` ---
# For local-build deploys (LiveKit-coexist setup):
#   BACKEND_IMAGE=academy-backend:latest
#   FRONTEND_IMAGE=academy-frontend:latest
BACKEND_IMAGE=academy-backend:latest
FRONTEND_IMAGE=academy-frontend:latest
