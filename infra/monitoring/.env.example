# Copy to .env next to docker-compose.monitoring.yml and fill in. Gitignored.
#
#   cp .env.example .env
#   docker compose -p academy-monitoring -f docker-compose.monitoring.yml up -d

# Grafana admin credentials. Defaults to admin/admin if you don't set these,
# which is FINE only because the port is bound to 127.0.0.1 — but rotate it.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_me_with_a_long_random_string

# Postgres exporter DSN. Point at the prod DB you want to monitor.
# Note: the exporter runs in its own compose project, so to reach the prod
# Postgres container by name, share a Docker network (see DEPLOYMENT.md §11).
# Until then, use host-relative addressing:
#   postgresql://academy_prod_user:<pw>@host.docker.internal:5432/academy_prod?sslmode=disable
POSTGRES_EXPORTER_DSN=postgresql://academy_prod_user:replace_me@host.docker.internal:5432/academy_prod?sslmode=disable
